(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath (param "WT"))
  (subpath (param "GITDIR"))
  (subpath "/private/tmp")
  (subpath "/private/var")
  (subpath "/dev")
  (subpath (string-append (param "HOMEDIR") "/.claude"))
  (subpath (string-append (param "HOMEDIR") "/.cache"))
  (subpath (string-append (param "HOMEDIR") "/.npm"))
  (subpath (string-append (param "HOMEDIR") "/.bun"))
  (subpath (string-append (param "HOMEDIR") "/.cargo"))
  (subpath (string-append (param "HOMEDIR") "/Library/Caches"))
  (subpath (string-append (param "HOMEDIR") "/Library/Logs")))
(deny file-read* file-read-metadata
  (subpath (string-append (param "HOMEDIR") "/.ssh"))
  (subpath (string-append (param "HOMEDIR") "/.jarvis"))
  (subpath (string-append (param "HOMEDIR") "/.config/conveyor"))
  (subpath (string-append (param "HOMEDIR") "/.aws"))
  (subpath (string-append (param "HOMEDIR") "/.gnupg"))
  (subpath (string-append (param "HOMEDIR") "/.docker"))
  (subpath (string-append (param "HOMEDIR") "/.netrc"))
  (subpath (string-append (param "HOMEDIR") "/.npmrc"))
  (subpath (string-append (param "HOMEDIR") "/.git-credentials"))
  (subpath (string-append (param "HOMEDIR") "/Library/Application Support/Claude")))
